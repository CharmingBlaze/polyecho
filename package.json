{
  "name": "polyecho",
  "private": true,
  "version": "1.2.0",
  "description": "Desktop low-poly 3D modeling, UV pixel painting, and skeletal animation",
  "author": "PolyEcho",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "desktop": "electron .",
    "build": "vue-tsc -b && vite build",
    "dist": "npm run icon && npm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test:topology": "vitest run src/core/mesh/TopologyAudit.test.ts",
    "test:mesh": "vitest run src/core/mesh",
    "test:io": "vitest run src/core/import src/core/export",
    "handoff:glb": "vitest run src/core/export/EngineHandoff.test.ts",
    "icon": "vitest run src/core/desktop/appIcon.test.ts",
    "collab:bus": "py -3 scripts/collab_bus.py serve",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.polyecho.app",
    "productName": "PolyEcho",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraFiles": [
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PolyEcho"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "fileAssociations": [
      {
        "ext": "psxproj",
        "name": "PolyEcho Project",
        "description": "PolyEcho project file",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vscode/codicons": "^0.0.46-24",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.1",
    "postcss": "^8.4.49",
    "reka-ui": "^2.10.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.170.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@voluma/three-transform-gizmo": "^1.0.0",
    "cad-camera-controls": "^0.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
